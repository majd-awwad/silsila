# مفتاح OpenRouter من openrouter.ai/keys . ما بينحط بالمستودع أبداً. بدونه التطبيق بيشتغل بالوضع الاحتياطي.
OPENROUTER_API_KEY=
# موديل التشخيص (slug من openrouter.ai/models). بنختاره بعد المقارنة: npm run eval:models -- --models=a,b,c
LLM_MODEL=google/gemini-2.5-flash
# اختياري: موديلات الصوت (OpenRouter /audio). بدونهم بنستعمل صوت المتصفح.
STT_MODEL=
TTS_MODEL=
# اختياري: للصف الحي لما التطبيق منشور على Vercel (مجاني من upstash.com). بدونهم الصف الحي بيشتغل على لابتوب واحد بس.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
