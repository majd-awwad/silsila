# مفتاح منفصل من console.anthropic.com (مش اشتراكات Claude). ما بينحط بالمستودع أبداً.
ANTHROPIC_API_KEY=
# اختياري: النموذج المستعمل للتشخيص
ANTHROPIC_MODEL=claude-sonnet-5-5
# اختياري: للصف الحي لما التطبيق منشور على Vercel (مجاني من upstash.com). بدونهم الصف الحي بيشتغل على لابتوب واحد بس.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
